cd ~/CSS_Training/terraform-hacks

cat > .gitignore <<'EOF'
# Terraform working directory and downloaded providers
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Sensitive variable files
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc
EOF
